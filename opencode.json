{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "description": "Live documentation lookup para frameworks y librerías"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PAT_HERE"
      },
      "enabled": false,
      "description": "Operaciones de GitHub - PRs, issues, repos"
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY_HERE"
      },
      "enabled": false,
      "description": "Web scraping y crawling"
    },
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest", "--project-ref=YOUR_PROJECT_REF"],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN_HERE"
      },
      "enabled": false,
      "description": "Operaciones de base de datos Supabase"
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": false,
      "description": "Memoria persistente entre sesiones"
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false,
      "description": "Razonamiento en cadena"
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": false,
      "description": "Deployments y proyectos Vercel (OAuth)"
    },
    "railway": {
      "type": "local",
      "command": ["npx", "-y", "@railway/mcp-server"],
      "enabled": false,
      "description": "Deployments Railway"
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false,
      "description": "Búsqueda de documentación Cloudflare"
    },
    "cloudflare-workers-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": false,
      "description": "Builds de Cloudflare Workers (OAuth)"
    },
    "cloudflare-workers-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
      "description": "Bindings de Cloudflare Workers (OAuth)"
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "description": "Observabilidad/logs de Cloudflare"
    },
    "clickhouse": {
      "type": "remote",
      "url": "https://mcp.clickhouse.cloud/mcp",
      "enabled": false,
      "description": "Consultas analíticas ClickHouse"
    },
    "magic": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "enabled": false,
      "description": "Componentes Magic UI"
    }
  },
  "_readme": "Activa solo los MCP que necesites (enabled: true). Mantén menos de 10 habilitados para preservar la ventana de contexto. Reemplaza los placeholders YOUR_*_HERE con valores reales. Equivalente opencode de docs/claude-code/mcp-configs/mcp-servers.json"
}